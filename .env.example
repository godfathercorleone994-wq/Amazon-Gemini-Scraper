# Application
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=change-me-in-production-use-strong-random-key
PORT=8000

# Database
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://default:password@redis-host:6379

# Celery
CELERY_BROKER_URL=redis://default:password@redis-host:6379/1

# AI APIs
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=your-bucket-name

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
SENDGRID_API_KEY=your-sendgrid-api-key
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
