# Application Settings
APP_NAME=Amazon-Gemini-Scraper
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
API_PREFIX=/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=False
LOG_LEVEL=INFO

# Database Configuration (MongoDB Atlas)
# Get your connection string from MongoDB Atlas
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DATABASE=amazon_scraper
MONGODB_MAX_CONNECTIONS=100
MONGODB_MIN_CONNECTIONS=10

# Redis Configuration
# For Render, use Redis addon or external Redis service
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=50

# AI API Keys (at least one required)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# AI Configuration
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_MODEL_GEMINI=gemini-pro
AI_MODEL_OPENAI=gpt-4-turbo-preview

# AWS Configuration (Optional - for S3 storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Notification Configuration (Optional)
# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_IDS=chat_id1,chat_id2

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_ADMIN=admin@yourdomain.com

# Discord
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=60
SCRAPER_RATE_LIMIT=10

# Scraping Configuration
MAX_CONCURRENT_SCRAPERS=5
SCRAPER_TIMEOUT=30000
SCRAPER_HEADLESS=True
USE_PROXY=False
PROXY_LIST=
USER_AGENT_ROTATION=True
MAX_RETRIES=3
RETRY_DELAY=5

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_CONCURRENCY=4

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_ENABLED=True

# Security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=*
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# Features
ENABLE_ML_FEATURES=True
ENABLE_NOTIFICATIONS=True
ENABLE_DASHBOARD=True
ENABLE_WEBHOOKS=True
