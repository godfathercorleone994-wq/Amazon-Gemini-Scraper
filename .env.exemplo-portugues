# ============================================
# TELEGRAM BOT - CONFIGURAÇÃO OBRIGATÓRIA
# ============================================

# 1. Crie seu bot no Telegram:
#    - Abra o Telegram e procure @BotFather
#    - Envie: /newbot
#    - Siga as instruções
#    - Copie o token que você receber
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz-exemplo

# ============================================
# BANCO DE DADOS - OBRIGATÓRIO
# ============================================

# 2. MongoDB Atlas (gratuito):
#    - Acesse: https://www.mongodb.com/cloud/atlas/register
#    - Crie um cluster gratuito
#    - Em "Connect" → "Connect your application"
#    - Copie a connection string
MONGODB_ATLAS_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# 3. Redis (escolha uma opção):
#    - Redis Cloud (gratuito): https://redis.com/try-free/
#    - Redis Local: redis://localhost:6379
REDIS_URL=redis://default:senha@host.redis.cloud:12345

# ============================================
# INTELIGÊNCIA ARTIFICIAL - OBRIGATÓRIO
# ============================================

# 4. Google Gemini API (gratuito):
#    - Acesse: https://makersuite.google.com/app/apikey
#    - Clique em "Get API Key" ou "Create API Key"
#    - Copie a chave
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURAÇÕES OPCIONAIS
# ============================================

# OpenAI (opcional - apenas se quiser usar GPT)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid (opcional - apenas para emails)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord (opcional - apenas para notificações no Discord)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxx

# Sentry (opcional - apenas para monitoramento de erros)
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxxx

# AWS S3 (opcional - apenas se quiser armazenar imagens)
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_BUCKET_NAME=nome-do-bucket

# ============================================
# CONFIGURAÇÕES DO SISTEMA (pode deixar como está)
# ============================================

ENVIRONMENT=production
DEBUG=False
SECRET_KEY=mude-isso-para-uma-chave-aleatoria-forte
LOG_LEVEL=INFO
